# ============================================================================
# MCP Image Generation Agent - Environment Configuration
# ============================================================================

# ---------------------------------------------------------------------------
# Agent Identity
# ---------------------------------------------------------------------------
AGENT_NAME=ImageGenerator
AGENT_VERSION=1.0.0
AGENT_DESCRIPTION="MCP-based image generation agent using OpenRouter"

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# OpenRouter API (REQUIRED)
# https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model for image generation
# Options: google/gemini-2.0-flash-exp:image, flux/flux-1.1-pro
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-exp:image

# Backup model if primary fails
OPENROUTER_FALLBACK_MODEL=flux/flux-1.1-pro

# ---------------------------------------------------------------------------
# Task Storage
# ---------------------------------------------------------------------------
# Options: "memory" (development) or "redis" (production)
TASK_STORE_TYPE=redis

# Redis connection (if TASK_STORE_TYPE=redis)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Task TTL (how long to keep completed tasks in seconds)
TASK_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Timeouts & Limits
# ---------------------------------------------------------------------------
# Image generation timeout (milliseconds)
IMAGE_GENERATION_TIMEOUT=300000

# HTTP request timeout (milliseconds)
HTTP_REQUEST_TIMEOUT=60000

# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=10

# ---------------------------------------------------------------------------
# Callbacks
# ---------------------------------------------------------------------------
# Callback request timeout (milliseconds)
CALLBACK_TIMEOUT=10000

# Number of retry attempts for failed callbacks
CALLBACK_RETRY_ATTEMPTS=3

# Delay between callback retries (milliseconds)
CALLBACK_RETRY_DELAY=1000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, pretty
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Cost Tracking
# ---------------------------------------------------------------------------
# Default pricing (USD) if OpenRouter doesn't report cost
DEFAULT_IMAGE_COST=0.08

# ---------------------------------------------------------------------------
# Agent Registration (for AgentsStack marketplace)
# ---------------------------------------------------------------------------
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_BASE_PRICE=0.08
AGENT_CAPABILITIES="hero images, social graphics, product mockups, illustrations"
