# ============================================================================
# MCP Video Generation Agent - Environment Configuration
# ============================================================================

# ---------------------------------------------------------------------------
# Agent Identity
# ---------------------------------------------------------------------------
AGENT_NAME=VideoGenerator
AGENT_VERSION=1.0.0
AGENT_DESCRIPTION="MCP-based video generation agent using OpenAI Sora 2"

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# OpenAI Sora 2 API (REQUIRED)
# https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sora model version
# Options: sora-2 (standard), sora-2-pro (higher quality)
OPENAI_VIDEO_MODEL=sora-2

# Maximum video duration in seconds
# Allowed values: 4, 8, or 12 (Sora 2 limitation)
MAX_VIDEO_DURATION=12

# ---------------------------------------------------------------------------
# Task Storage
# ---------------------------------------------------------------------------
# Options: "memory" (development) or "redis" (production)
TASK_STORE_TYPE=redis

# Redis connection (if TASK_STORE_TYPE=redis)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=2  # Different DB from image-gen-agent

# Task TTL (how long to keep completed tasks in seconds)
TASK_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Timeouts & Limits
# ---------------------------------------------------------------------------
# Video generation timeout (milliseconds) - 10 minutes
VIDEO_GENERATION_TIMEOUT=600000

# HTTP request timeout (milliseconds)
HTTP_REQUEST_TIMEOUT=60000

# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=5

# ---------------------------------------------------------------------------
# Callbacks
# ---------------------------------------------------------------------------
# Callback request timeout (milliseconds)
CALLBACK_TIMEOUT=10000

# Number of retry attempts for failed callbacks
CALLBACK_RETRY_ATTEMPTS=3

# Delay between callback retries (milliseconds)
CALLBACK_RETRY_DELAY=1000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, pretty
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Cost Tracking
# ---------------------------------------------------------------------------
# Default pricing (USD) - estimates until official Sora pricing announced
DEFAULT_VIDEO_COST=0.50

# Cost per second of video
COST_PER_SECOND=0.05

# ---------------------------------------------------------------------------
# Agent Registration (for AgentsStack marketplace)
# ---------------------------------------------------------------------------
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_BASE_PRICE=0.50
AGENT_CAPABILITIES="short videos, promotional content, social media clips, product demos"
