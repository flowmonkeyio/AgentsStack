# =============================================================================
# AgentStack Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# MONGODB ATLAS
# https://cloud.mongodb.com
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# OPENROUTER (Unified LLM Gateway - RECOMMENDED)
# https://openrouter.ai/keys
# Used for: All internal agents via unified API (400+ models)
# Provides: Automatic fallbacks, unified billing, model switching
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPENAI (Direct - Optional)
# https://platform.openai.com/api-keys
# Used for: Direct OpenAI calls if not using OpenRouter
# Best Galileo integration support
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ANTHROPIC (Claude - Optional)
# https://console.anthropic.com/settings/keys
# Used for: Direct Anthropic calls if not using OpenRouter
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# GALILEO AI
# https://app.galileo.ai (Settings > API Keys)
# Used for: Output verification + observability tracing
# -----------------------------------------------------------------------------
GALILEO_API_KEY=
GALILEO_PROJECT_ID=
GALILEO_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# COINBASE CDP (Developer Platform)
# https://portal.cdp.coinbase.com/projects/api-keys
# Used for: x402 payments + wallet management
# -----------------------------------------------------------------------------
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_NETWORK=base-sepolia

# Platform wallet (create after SDK setup)
PLATFORM_WALLET_ID=
PLATFORM_WALLET_ADDRESS=

# -----------------------------------------------------------------------------
# VOYAGE AI
# https://dash.voyageai.com
# Used for: Agent capability embeddings (vector search)
# -----------------------------------------------------------------------------
VOYAGE_API_KEY=

# -----------------------------------------------------------------------------
# FIREWORKS AI
# https://fireworks.ai/dashboard
# Used for: Demo ImageGen agent (Stable Diffusion XL)
# -----------------------------------------------------------------------------
FIREWORKS_API_KEY=

# -----------------------------------------------------------------------------
# CLERK (Authentication)
# https://dashboard.clerk.com
# Used for: User authentication in Next.js frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# LANGSMITH (LangGraph Observability - Optional)
# https://smith.langchain.com
# Used for: LangGraph tracing and debugging
# -----------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=agentstack-prod

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
